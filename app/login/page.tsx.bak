import type { Metadata } from "next"
import { notFound } from "next/navigation"
import { AuthPage } from "@/components/account/auth-page"
import { billingEnabled } from "@/lib/billing/config"

export const dynamic = "force-dynamic"
export const metadata: Metadata = { title: "Sign in", robots: { index: false, follow: false } }

// Not linked from anywhere and not in the sitemap. Reachable by address while the account feature is on.
export default function Page() {
  if (!billingEnabled()) notFound()
  return <div className="mx-auto w-full max-w-md px-4 py-12"><AuthPage mode="login" /></div>
}
